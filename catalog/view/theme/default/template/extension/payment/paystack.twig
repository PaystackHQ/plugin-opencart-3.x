{% if not livemode %}
 <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ text_testmode }}
{% endif %}

<form >
  <script src="https://js.paystack.co/v1/inline.js"></script>
  <div class="buttons">
    <div class="pull-right">
      <input type="button"  onclick="payWithPaystack()" value="{{button_confirm}}" class="btn btn-primary" />
    </div>
  </div>
</form>

{% set json_flags = constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') %}
<script>
  function payWithPaystack(){
    var handler = PaystackPop.setup({
      key: {{ key|json_encode(json_flags) }},
      currency: {{ currency|json_encode(json_flags) }},
      email: {{ email|json_encode(json_flags) }},
      amount: {{amount}},
      ref: {{ ref|json_encode(json_flags) }},
      metadata:{
         "custom_fields":[
            {
              "display_name":"Plugin",
              "variable_name":"plugin",
              "value":"opencart-3.x"
            }
          ]
      },
      callback: function(response){
          window.location.href={{ callback|json_encode(json_flags) }}.replace(/&amp;/g, '&');
      },
      onClose: function(){
          window.location.href={{ callback|json_encode(json_flags) }}.replace(/&amp;/g, '&');
      }
    });
    handler.openIframe();
  }
</script>
