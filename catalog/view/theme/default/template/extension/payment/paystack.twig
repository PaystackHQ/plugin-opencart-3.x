{% if not livemode %}
 <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ text_testmode }}
{% endif %}

<form >
  <script src="https://js.paystack.co/v1/inline.js"></script>
  <div class="buttons">
    <div class="pull-right">
      <input type="button"  onclick="payWithPaystack()" value="{{button_confirm}}" class="btn btn-primary" />
    </div>
  </div>
</form>
 
<script>
  function payWithPaystack(){
    var handler = PaystackPop.setup({
      key: {{ key|json_encode }},
      currency: {{ currency|json_encode }},
      email: {{ email|json_encode }},
      amount: {{amount}},
      ref: {{ ref|json_encode }},
      metadata:{
         "custom_fields":[
            {
              "display_name":"Plugin",
              "variable_name":"plugin",
              "value":"opencart-3.x"
            }
          ]
      },
      callback: function(response){
          window.location.href={{ callback|json_encode }}.replace(/&amp;/g, '&');
      },
      onClose: function(){
          window.location.href={{ callback|json_encode }}.replace(/&amp;/g, '&');
      }
    });
    handler.openIframe();
  }
</script>
